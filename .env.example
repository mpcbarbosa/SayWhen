# Copia para .env (desenvolvimento local) ou preenche no painel do Render.

# Chave de acesso à área do organizador. Sem ela, a área fica ABERTA.
ADMIN_KEY=escolhe-uma-chave-longa

# Envio de email (resend.com). Sem chave, os emails vão só para o log.
RESEND_API_KEY=
MAIL_FROM=SayWhen <sondagens@mail.e-news.app>

# Endereço público, usado nos links dos convites.
PUBLIC_URL=http://localhost:3000

# Idioma da área do organizador: pt | es | en
UI_LANG=pt

# Base de dados. Vazio = ficheiro JSON em DATA_DIR (só para testes locais).
DATABASE_URL=
DATA_DIR=./data

PORT=3000
